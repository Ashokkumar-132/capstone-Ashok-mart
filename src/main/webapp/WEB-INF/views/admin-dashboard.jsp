<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin Dashboard | AshokMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/auth.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin.css"></head><body><jsp:include page="/WEB-INF/views/includes/header.jsp"/><main class="admin-layout"><section class="admin-hero"><div><p class="eyebrow">Administration</p><h1>Keep AshokMart healthy.</h1><p class="lede">Review users, products, and orders from one secure workspace.</p></div></section><section class="admin-stat-grid" aria-label="Marketplace statistics"><article class="admin-stat accent"><span>Total users</span><strong>${statistics.totalUsers}</strong></article><article class="admin-stat"><span>Active users</span><strong>${statistics.activeUsers}</strong></article><article class="admin-stat"><span>Total products</span><strong>${statistics.totalProducts}</strong></article><article class="admin-stat accent"><span>Active products</span><strong>${statistics.activeProducts}</strong></article><article class="admin-stat"><span>Total orders</span><strong>${statistics.totalOrders}</strong></article><article class="admin-stat warn"><span>Revenue</span><strong class="admin-stat-small"><fmt:formatNumber value="${statistics.totalRevenue}" type="currency" currencyCode="USD"/></strong></article></section><section class="admin-panel"><div class="admin-panel-heading"><div><p class="eyebrow">Quick access</p><h2>Marketplace operations</h2></div></div><div class="admin-quick-links"><a class="admin-quick-link" href="${pageContext.request.contextPath}/admin/users"><div><strong>Manage users</strong><span>Search, filter, activate, or deactivate accounts.</span></div><span aria-hidden="true">→</span></a><a class="admin-quick-link" href="${pageContext.request.contextPath}/admin/products"><div><strong>Manage products</strong><span>Review seller listings and availability.</span></div><span aria-hidden="true">→</span></a><a class="admin-quick-link" href="${pageContext.request.contextPath}/admin/orders"><div><strong>Manage orders</strong><span>Inspect buyers, sellers, totals, and history.</span></div><span aria-hidden="true">→</span></a></div></section></main></body></html>
