<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin Dashboard | AshokMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/auth.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin.css"></head>
<body><jsp:include page="/WEB-INF/views/includes/header.jsp" /><main class="admin-layout"><section class="admin-hero"><div><p class="eyebrow">Administration</p><h1>Keep AshokMart healthy.</h1><p class="lede">Review account activity and protect the marketplace from one secure workspace.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/users">Manage users</a></section><section class="admin-stat-grid" aria-label="User statistics"><article class="admin-stat accent"><span>Total users</span><strong>${statistics.totalUsers}</strong></article><article class="admin-stat"><span>Buyers</span><strong>${statistics.buyers}</strong></article><article class="admin-stat"><span>Sellers</span><strong>${statistics.sellers}</strong></article><article class="admin-stat"><span>Administrators</span><strong>${statistics.admins}</strong></article><article class="admin-stat accent"><span>Active accounts</span><strong>${statistics.activeUsers}</strong></article><article class="admin-stat muted"><span>Inactive accounts</span><strong>${statistics.inactiveUsers}</strong></article></section><section class="admin-panel"><div class="admin-panel-heading"><div><p class="eyebrow">Quick access</p><h2>Account operations</h2></div></div><div class="admin-quick-links"><a class="admin-quick-link" href="${pageContext.request.contextPath}/admin/users"><div><strong>Manage users</strong><span>Search, filter, activate, or deactivate accounts.</span></div><span aria-hidden="true">→</span></a><a class="admin-quick-link" href="${pageContext.request.contextPath}/products"><div><strong>View marketplace</strong><span>Open the customer-facing catalog.</span></div><span aria-hidden="true">→</span></a></div></section></main></body></html>
