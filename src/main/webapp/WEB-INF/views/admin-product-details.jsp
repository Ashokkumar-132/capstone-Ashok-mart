<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${adminProduct.name} | AshokMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/auth.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin.css"></head><body><jsp:include page="/WEB-INF/views/includes/header.jsp"/><main class="admin-layout"><div class="admin-page-heading"><div><p class="eyebrow">Product detail</p><h1>${adminProduct.name}</h1><p class="lede">Product #${adminProduct.id} · Seller-owned marketplace listing.</p></div><a class="back-link" href="${pageContext.request.contextPath}/admin/products">← Products</a></div><section class="admin-panel admin-detail-grid"><div><span class="summary-label">Category</span><strong>${adminProduct.categoryName}</strong></div><div><span class="summary-label">Seller</span><strong>${adminProduct.sellerName}</strong></div><div><span class="summary-label">Price</span><strong><fmt:formatNumber value="${adminProduct.price}" type="currency" currencyCode="USD"/></strong></div><div><span class="summary-label">Stock</span><strong>${adminProduct.stockQuantity}</strong></div><div><span class="summary-label">Status</span><strong class="admin-status ${adminProduct.active ? 'active' : 'inactive'}">${adminProduct.active ? 'Active' : 'Inactive'}</strong></div><div class="admin-detail-description"><span class="summary-label">Description</span><p>${adminProduct.description}</p></div></section></main></body></html>
