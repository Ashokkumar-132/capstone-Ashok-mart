<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Products | AshokMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/auth.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin.css"></head><body><jsp:include page="/WEB-INF/views/includes/header.jsp"/><main class="admin-layout"><div class="admin-page-heading"><div><p class="eyebrow">Administration</p><h1>Product management</h1><p class="lede">Review every marketplace product without changing seller ownership.</p></div><a class="back-link" href="${pageContext.request.contextPath}/admin/dashboard">← Dashboard</a></div><c:if test="${not empty adminSuccess}"><p class="flash-success">${adminSuccess}</p></c:if><c:if test="${not empty adminError}"><p class="flash-error">${adminError}</p></c:if><section class="admin-panel"><form class="admin-filter-bar" method="get"><label>Search<input name="search" value="${searchTerm}" placeholder="Name or description"></label><label>Category<select name="category"><option value="">All categories</option><c:forEach items="${categories}" var="category"><option value="${category.id}" <c:if test="${selectedCategory == category.id}">selected</c:if>>${category.name}</option></c:forEach></select></label><label>Status<select name="active"><option value="">All statuses</option><option value="active" <c:if test="${selectedActive == 'active'}">selected</c:if>>Active</option><option value="inactive" <c:if test="${selectedActive == 'inactive'}">selected</c:if>>Inactive</option></select></label><label>Stock<select name="stock"><option value="">All stock</option><option value="in_stock" <c:if test="${selectedStock == 'in_stock'}">selected</c:if>>In stock</option><option value="out_of_stock" <c:if test="${selectedStock == 'out_of_stock'}">selected</c:if>>Out of stock</option></select></label><button class="primary-button" type="submit">Apply filters</button></form><div class="admin-table-wrap"><table class="admin-table"><caption class="sr-only">Admin product list</caption><thead><tr><th>Product</th><th>Category</th><th>Seller</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:choose><c:when test="${empty productPage.products}"><tr><td colspan="7" class="admin-empty">No products match these filters.</td></tr></c:when><c:otherwise><c:forEach items="${productPage.products}" var="product"><tr><td><strong>${product.name}</strong><small>ID #${product.id}</small></td><td>${product.categoryName}</td><td>${product.sellerName}</td><td><fmt:formatNumber value="${product.price}" type="currency" currencyCode="USD"/></td><td>${product.stockQuantity}</td><td><span class="admin-status ${product.active ? 'active' : 'inactive'}">${product.active ? 'Active' : 'Inactive'}</span></td><td><a href="${pageContext.request.contextPath}/admin/products/view?id=${product.id}">View</a> <form class="admin-inline-form" method="post" action="${pageContext.request.contextPath}/admin/products/${product.active ? 'deactivate' : 'activate'}"><input type="hidden" name="productId" value="${product.id}"><button class="link-button ${product.active ? 'danger' : ''}" type="submit">${product.active ? 'Deactivate' : 'Activate'}</button></form></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div><div class="admin-pagination"><span>Page ${productPage.currentPage} of ${productPage.totalPages} · ${productPage.totalResults} products</span><span><c:if test="${productPage.hasPrevious}"><a href="?page=${productPage.currentPage - 1}&search=${searchTerm}&active=${selectedActive}&stock=${selectedStock}">Previous</a></c:if> <c:if test="${productPage.hasNext}"><a href="?page=${productPage.currentPage + 1}&search=${searchTerm}&active=${selectedActive}&stock=${selectedStock}">Next</a></c:if></span></div></section></main></body></html>
