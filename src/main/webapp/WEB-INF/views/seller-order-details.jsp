<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><c:choose><c:when test="${sellerOrderNotFound}">Order not found</c:when><c:otherwise>Seller Order #${sellerOrderDetails.order.id}</c:otherwise></c:choose> | AshokMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/auth.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/seller.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/seller-orders.css"></head>
<body><jsp:include page="/WEB-INF/views/includes/header.jsp" /><main class="seller-layout"><c:choose><c:when test="${sellerOrderNotFound}"><section class="seller-empty seller-panel"><p class="eyebrow">Order unavailable</p><h1>We could not find that order.</h1><p>This order may not contain one of your products.</p><a class="secondary-button" href="${pageContext.request.contextPath}/seller/orders">Back to seller orders</a></section></c:when><c:otherwise><div class="seller-page-heading"><div><p class="eyebrow">Fulfillment detail</p><h1>Order #${sellerOrderDetails.order.id}</h1><p class="lede">Placed ${sellerOrderDetails.order.createdAt}. Only your products are shown.</p></div><a class="back-link" href="${pageContext.request.contextPath}/seller/orders">← Back to seller orders</a></div><section class="seller-order-summary seller-panel"><div><span class="summary-label">Order status</span><strong class="order-status status-${fn:toLowerCase(sellerOrderDetails.order.status)}"><span class="status-dot"></span>${sellerOrderDetails.order.status}</strong></div><div><span class="summary-label">Your items</span><strong>${fn:length(sellerOrderDetails.items)}</strong></div><div><span class="summary-label">Your subtotal</span><strong><fmt:formatNumber value="${sellerOrderDetails.sellerSubtotal}" type="currency" currencyCode="USD" /></strong></div></section><section class="seller-panel seller-items-panel"><div class="seller-panel-heading"><div><p class="eyebrow">Owned line items</p><h2>Products to fulfill</h2></div><span class="seller-note">Historical prices shown</span></div><c:forEach items="${sellerOrderDetails.items}" var="item"><article class="seller-item-row"><div class="seller-thumb"><c:choose><c:when test="${not empty item.imageUrl}"><img src="${item.imageUrl}" alt="${item.productName}"></c:when><c:otherwise><span>AM</span></c:otherwise></c:choose></div><div><h3>${item.productName}</h3><p>${item.quantity} × <fmt:formatNumber value="${item.unitPrice}" type="currency" currencyCode="USD" /> at purchase</p></div><strong><fmt:formatNumber value="${item.subtotal}" type="currency" currencyCode="USD" /></strong></article></c:forEach><div class="seller-total-row"><span>Your fulfillment subtotal</span><strong><fmt:formatNumber value="${sellerOrderDetails.sellerSubtotal}" type="currency" currencyCode="USD" /></strong></div></section><section class="seller-panel seller-status-panel"><div><p class="eyebrow">Shared order status</p><h2>Update fulfillment</h2><p class="seller-note">The current schema stores status at order level. Updating it changes the buyer-visible status for the full order, including any other seller's items.</p></div><form method="post" action="${pageContext.request.contextPath}/seller/orders/status" class="seller-status-form"><input type="hidden" name="orderId" value="${sellerOrderDetails.order.id}"><label for="status">New status</label><select id="status" name="status" required><c:if test="${sellerOrderDetails.order.status == 'PENDING'}"><option value="CONFIRMED">Confirmed</option><option value="CANCELLED">Cancelled</option></c:if><c:if test="${sellerOrderDetails.order.status == 'CONFIRMED'}"><option value="PROCESSING">Processing</option><option value="CANCELLED">Cancelled</option></c:if><c:if test="${sellerOrderDetails.order.status == 'PROCESSING'}"><option value="SHIPPED">Shipped</option><option value="CANCELLED">Cancelled</option></c:if><c:if test="${sellerOrderDetails.order.status == 'SHIPPED'}"><option value="DELIVERED">Delivered</option></c:if><c:if test="${sellerOrderDetails.order.status == 'DELIVERED' || sellerOrderDetails.order.status == 'CANCELLED'}"><option value="${sellerOrderDetails.order.status}">${sellerOrderDetails.order.status} (final)</option></c:if></select><button class="primary-button seller-small-button" type="submit" <c:if test="${sellerOrderDetails.order.status == 'DELIVERED' || sellerOrderDetails.order.status == 'CANCELLED'}">disabled</c:if>>Save status</button></form></section></c:otherwise></c:choose></main></body></html>
